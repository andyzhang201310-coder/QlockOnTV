<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 错题讲解面板（v1.10.6）：题目与对错信息在上，四段讲解正文在面板内翻页，底部「继续下一题」按钮缩小。
  窗口高度由代码固定为屏高 70%（宽 82%），上下各留 15%；正文区用 weight 吃掉剩余空间，
  超长内容靠遥控器上下键在面板内翻页，标题与「继续下一题」始终完整可见。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aiPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingLeft="34dp"
    android:paddingTop="28dp"
    android:paddingRight="34dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tvAiTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 讲解"
        android:textColor="@color/accent"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAiMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/textSecondary"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/aiScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvAiBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="7dp"
            android:minHeight="104dp"
            android:text="正在想怎么讲给你听…"
            android:textColor="@color/textPrimary"
            android:textSize="20sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="right|center_vertical"
        android:orientation="horizontal">

        <!-- v1.10.6：翻页提示与「继续下一题」同一水平线，靠 weight 占左侧剩余空间 -->
        <TextView
            android:id="@+id/tvAiMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left|center_vertical"
            android:text="↓ 还有内容 · 按遥控器上下键翻看"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- v1.10.6：按钮缩小一圈，别抢讲解正文的视觉重心；
             style 里的 19sp/62dp/22dp 由这里的同名属性覆盖 -->
        <Button
            android:id="@+id/btnAiRetry"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="104dp"
            android:minHeight="44dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="重试"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAiClose"
            style="@style/TvButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:minWidth="128dp"
            android:minHeight="44dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="继续下一题"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
