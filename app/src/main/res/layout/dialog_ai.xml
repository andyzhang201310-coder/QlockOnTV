<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 错题讲解面板（v1.10.5）：题目与对错信息在上，六段讲解正文占屏高 42%、在面板内翻页，底部「继续下一题」。
  窗口高度由代码固定为屏高 70%（宽 82%），上下各留 15%；正文区用 weight 吃掉剩余空间，
  超长内容靠遥控器上下键在面板内翻页，标题与「继续下一题」始终完整可见。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aiPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingLeft="34dp"
    android:paddingTop="28dp"
    android:paddingRight="34dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tvAiTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 讲解"
        android:textColor="@color/accent"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAiMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/textSecondary"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/aiScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvAiBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="7dp"
            android:minHeight="104dp"
            android:text="正在想怎么讲给你听…"
            android:textColor="@color/textPrimary"
            android:textSize="20sp" />
    </ScrollView>

    <TextView
        android:id="@+id/tvAiMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="↓ 还有内容 · 按遥控器上下键翻看"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="right|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAiRetry"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:text="重试"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAiClose"
            style="@style/TvButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:minWidth="170dp"
            android:text="继续下一题" />
    </LinearLayout>
</LinearLayout>
