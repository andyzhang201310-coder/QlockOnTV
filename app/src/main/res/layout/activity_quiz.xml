<?xml version="1.0" encoding="utf-8"?>
<!--
  答题页（v1.7.12 视觉）：顶栏品牌 + 右上系统时钟，中部大题干 + 卡片式选项，底部固定反馈卡片。
  题目与选项可滚动以容纳长成语解释；反馈/提示固定在屏幕底部，答错时始终看得见。
  短答案时四个选项必须同屏可见，因此纵向间距按 TV 一屏高度收紧；反馈为空时由 Java 隐藏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow"
    android:orientation="vertical">

    <!-- 顶栏：品牌 + 右上状态胶囊，参考项目 .topbar / .pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="56dp"
        android:paddingTop="14dp"
        android:paddingRight="56dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="题锁"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/BrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="题锁" />

        <TextView
            style="@style/BrandTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="先学再看 · 让每一点进步被看见" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvClock"
            style="@style/ClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/quizScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="56dp"
            android:paddingTop="6dp"
            android:paddingRight="56dp"
            android:paddingBottom="2dp">

            <!-- 面包屑：学科胶囊 · 进度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag"
                    android:paddingLeft="18dp"
                    android:paddingTop="5dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="5dp"
                    android:text="语文"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="/"
                    android:textColor="#4A4A52"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="第 1 / 5 题"
                    android:textColor="@color/textSecondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuestion"
                style="@style/QuizQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="题目" />

            <!-- 选项高度 wrap_content：长答案自动换行撑高，短答案由 minHeight 保底 -->
            <LinearLayout
                android:id="@+id/optionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 短答案时吃掉剩余空间；内容超一屏时自动让位，不影响滚动 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="56dp"
        android:paddingTop="2dp"
        android:paddingRight="56dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feedback"
            android:minHeight="34dp"
            android:paddingLeft="22dp"
            android:paddingTop="7dp"
            android:paddingRight="22dp"
            android:paddingBottom="7dp"
            android:text=""
            android:textColor="@color/textSecondary"
            android:textSize="21sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/quiz_hint"
            android:textColor="@color/textMuted"
            android:textSize="14sp" />

    </LinearLayout>
</LinearLayout>
