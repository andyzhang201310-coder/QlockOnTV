<?xml version="1.0" encoding="utf-8"?>
<!-- 首次安装引导页 / 家长验证后的只读信息页。
     结构：上面是可滚动的两栏内容，下面是固定不滚动的全屏操作条。
     操作条横跨整屏，四个按钮各有约 165dp，不会被压到换行（旧版挤在右栏里约 88dp）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="48dp"
            android:paddingTop="28dp"
            android:paddingRight="48dp"
            android:paddingBottom="20dp">

            <!-- 左栏：品牌 + 二维码 + 首次配置步骤 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="题锁"
                        android:src="@mipmap/ic_launcher" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="手机扫码改设置"
                            android:textColor="@color/textPrimary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="微信「扫一扫」或手机浏览器打开"
                            android:textColor="@color/textSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_qr"
                    android:contentDescription="管理后台二维码"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 四步配置压成两行速记，保证首屏不被底部操作条切掉 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="首次配置：① 改管理密码 / 卸载码　② 允许后台弹窗\n③ 开启自启动　④ 激活防卸载设置"
                    android:textColor="@color/textSecondary"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 右栏：运行状态 + 需要留意的事项 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="运行状态"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:lineSpacingExtra="6dp"
                    android:padding="18dp"
                    android:text="加载中…"
                    android:textColor="@color/textPrimary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="4dp"
                    android:text=""
                    android:textColor="@color/amber"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="4dp"
                    android:text="以后要再看本页：在答题页连按 5 次「上键」并输入管理密码。\n电视端不提供参数修改，全部由手机管理页控制；答题通关后应用会自动退回后台继续计时。"
                    android:textColor="@color/textSecondary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 固定在屏幕底部的操作条：不管上面滚到哪里，遥控器都能直接找到按钮 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="12dp"
        android:paddingRight="48dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="常用操作"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="方向键选择 · 按 OK 确认"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverlay"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"
                android:layout_weight="1"
                android:text="允许后台弹窗" />

            <Button
                android:id="@+id/btnSecurity"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"
                android:layout_weight="1"
                android:text="防卸载设置" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="14dp"
                android:layout_weight="1"
                android:text="刷新二维码" />

            <Button
                android:id="@+id/btnClose"
                style="@style/TvButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="关闭" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
