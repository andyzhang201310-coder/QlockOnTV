<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="56dp"
        android:paddingTop="36dp"
        android:paddingRight="56dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="防卸载设置"
            android:textColor="@color/textPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="这一页只放必须在本机完成的动作，其他参数请用手机扫码修改"
            android:textColor="@color/textSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvGuard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="7dp"
            android:padding="22dp"
            android:text="检测中…"
            android:textColor="@color/textPrimary"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGuard"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:text="开启防卸载" />

            <Button
                android:id="@+id/btnOwner"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:text="彻底锁定（需 adb）" />

            <Button
                android:id="@+id/btnUninstall"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="12dp"
                android:text="卸载应用" />

            <Button
                android:id="@+id/btnBack"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="返回" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="说明：点「开启防卸载」会直接给本应用激活设备管理员，不需要去系统设置里找入口（电视通常没有这一项）；激活后孩子从系统设置卸载时会先被要求「停用设备管理员」。如果系统强制拦截、页面拉不起来，本页会给出两条 adb 命令，复制到电脑执行一次即可。想彻底置灰系统「卸载」按钮，用「彻底锁定（需 adb）」设为设备所有者。"
            android:textColor="@color/textSecondary"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
