<?xml version="1.0" encoding="utf-8"?>
<!-- 防卸载设置页（v1.7.12 视觉）：顶栏品牌 + 大标题 + 状态卡片 + 操作按钮 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="56dp"
        android:paddingTop="24dp"
        android:paddingRight="56dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="题锁"
                android:src="@mipmap/ic_launcher" />

            <TextView
                style="@style/BrandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="题锁" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                style="@style/PillText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本机权限设置" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="管控保护" />

        <TextView
            style="@style/PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="防卸载设置" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="这一页只放必须在本机完成的动作，其他参数请用手机扫码修改"
            android:textColor="@color/textSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvGuard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="8dp"
            android:padding="24dp"
            android:text="检测中…"
            android:textColor="@color/textPrimary"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGuard"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:text="开启防卸载" />

            <Button
                android:id="@+id/btnA11y"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:text="开启界面拦截" />

            <Button
                android:id="@+id/btnOwner"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="彻底锁定（需 adb）" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUninstall"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:text="卸载应用（需卸载码）" />

            <Button
                android:id="@+id/btnIcon"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:layout_weight="1"
                android:text="隐藏桌面图标" />

            <Button
                android:id="@+id/btnBack"
                style="@style/TvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="返回" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="6dp"
            android:text="三道闸门，从弱到强：①「开启防卸载」激活设备管理员，系统卸载前会先要求停用；②「开启界面拦截」用无障碍服务盯着卸载页面，没有卸载码就把界面顶掉——设备管理员在这台电视上无效时，这一条才是真正挡住孩子的那道；③「彻底锁定」把系统卸载按钮直接置灰，仅设备所有者可用，需要电脑执行一次 adb 命令。"
            android:textColor="@color/textMuted"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
