<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bgDeep</item>
        <item name="android:colorBackground">@color/bgDeep</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="QuizTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="DialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- 顶栏品牌：小而清晰，不抢题干 -->
    <style name="BrandName">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BrandTagline">
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 右上状态胶囊 -->
    <style name="PillText">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 右上角系统时钟：v1.8.1 起只留文字，去掉胶囊底与内边距，不参与视觉层级
         等宽数字（tnum）避免秒数跳动时整行左右抖 -->
    <style name="ClockText">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- 分区小标题：灰色字母感，参考项目的 crumb / section 层级 -->
    <style name="SectionLabel">
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="PageTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- v1.7.24：题干 38sp → 34sp（略微缩小，长题型标签题面一屏放得下） -->
    <style name="QuizQuestion">
        <item name="android:textColor">#FAFAFB</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">8dp</item>
    </style>

    <style name="TvButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 主按钮：暖橙渐变 + 深色字，和 TV / 家长端品牌一致 -->
    <style name="TvButtonPrimary" parent="TvButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#14100A</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 答案高度自适应：允许多行、不省略、不拉伸，长成语解释完整显示
         v1.7.24：选项 28sp → 25sp，字母徽标按实际字号计算会自动跟着缩
         v1.7.27：minHeight 72dp → 56dp、上下 padding 10dp → 8dp，
                 四个选项 + 题干 + 底部反馈在 1080p 电视上一屏放得下，最后一项不再被裁 -->
    <style name="QuizOption" parent="TvButton">
        <item name="android:textSize">25sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">none</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:paddingLeft">30dp</item>
        <item name="android:paddingRight">30dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="KeyButton" parent="TvButton">
        <item name="android:textSize">24sp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <!-- 答题页右下角的家长入口，刻意做得低调，且必须输管理密码 -->
    <style name="ManageButton" parent="TvButton">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">92dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>
    <!-- 每日轮数用完的锁屏页（v1.8.1）：从上到下 图标 / 大标题 / 副标题 / 底部说明，居中一列 -->
    <style name="LimitTitle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">46sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="LimitSubtitle">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="LimitFootnote">
        <item name="android:textColor">@color/textMuted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
